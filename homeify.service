[Unit]
Description=Homeify Personal Music Server (Tailscale)
After=network.target tailscaled.service

[Service]
Type=simple
User=idodi
WorkingDirectory=/home/idodi/Projects/homeify
ExecStart=/home/idodi/Projects/homeify/backend/venv/bin/python /home/idodi/Projects/homeify/backend/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
